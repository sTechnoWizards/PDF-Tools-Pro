# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Instructions:
# 1. Create a new Supabase project at https://supabase.com/dashboard
# 2. Copy your project URL and anon key from Project Settings → API
# 3. Create a .env.local file in the root directory
# 4. Copy these variables to .env.local and replace with your actual values
# 5. Never commit .env.local to Git (it's in .gitignore)
